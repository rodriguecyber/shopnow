# Values referenced by .k8s/*/deployment.yaml via envsubst.
# Copy to .env, fill in the outputs from `terraform output` (.infra), then:
#   set -a && source .k8s/.env && set +a
#   envsubst < .k8s/backend/deployment.yaml  | kubectl apply -f -
#   envsubst < .k8s/frontend/deployment.yaml | kubectl apply -f -

BACKEND_IMAGE=<account-id>.dkr.ecr.us-east-1.amazonaws.com/shopnow-ecs/backend:latest
FRONTEND_IMAGE=<account-id>.dkr.ecr.us-east-1.amazonaws.com/shopnow-ecs/frontend:latest
DB_HOST=<rds_endpoint output>
REDIS_HOST=<redis_endpoint output>
DB_SSL=true
